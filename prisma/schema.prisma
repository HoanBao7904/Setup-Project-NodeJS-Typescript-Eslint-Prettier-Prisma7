generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model comments {
  id         Int       @id @default(autoincrement())
  content    String
  user_id    Int
  tweet_id   Int
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  tweets     tweets    @relation(fields: [tweet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tweet_id, created_at(sort: Desc)], map: "idx_comments_tweet_created")
}

model deleted_users {
  id         Int      @id @default(autoincrement())
  user_id    Int
  username   String   @db.VarChar(50)
  created_at DateTime @db.Timestamp(6)
}

model followers {
  follower_id                         Int
  following_id                        Int
  users_followers_follower_idTousers  users @relation("followers_follower_idTousers", fields: [follower_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_followers_following_idTousers users @relation("followers_following_idTousers", fields: [following_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([follower_id, following_id])
  @@index([follower_id], map: "idx_followers_follower_id")
  @@index([follower_id], map: "idx_followers_follower_id1")
  @@index([following_id], map: "idx_followers_following_id")
  @@index([following_id], map: "idx_followers_following_id1")
}

model invoices {
  id         Int       @id @default(autoincrement())
  user_id    Int
  amount     Decimal   @db.Decimal(12, 2)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model tweet_history {
  id         Int       @id @default(autoincrement())
  tweet_id   Int
  content    String    @db.VarChar(100)
  created_at DateTime? @db.Timestamp(6)
  tweets     tweets    @relation(fields: [tweet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model tweets {
  id            Int             @id @default(autoincrement())
  content       String
  user_id       Int
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  comments      comments[]
  tweet_history tweet_history[]
  users         users           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_tweets_created")
  @@index([user_id, created_at(sort: Desc)], map: "idx_tweets_user_created")
  @@index([user_id], map: "idx_tweets_user_id")
  @@index([user_id], map: "idx_tweets_user_id1")
  @@index([user_id, created_at(sort: Desc)], map: "idx_tweets_userid_createdat_desc")
}

model users {
  id                                      Int         @id @default(autoincrement())
  username                                String      @db.VarChar(50)
  email                                   String?     @unique @db.VarChar(100)
  is_active                               Boolean?    @default(true)
  created_at                              DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime?   @db.Timestamptz(6)
  comments                                comments[]
  followers_followers_follower_idTousers  followers[] @relation("followers_follower_idTousers")
  followers_followers_following_idTousers followers[] @relation("followers_following_idTousers")
  invoices                                invoices[]
  tweets                                  tweets[]

  @@index([email], map: "idx_users_email")
  @@index([username], map: "idx_users_username")
}


model test_prisma {
  id   Int    @id @default(autoincrement())
  name String
}